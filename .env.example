# --- Upstream ---
OPENAI_API_KEY=
UPSTREAM_BASE_URL=https://api.openai.com/v1
MOCK_UPSTREAM=1            # 1 = simulated LLM (no key needed, great for demos)
MOCK_DELAY_S=0.9
# --- Embeddings: auto | openai | local ---
EMBEDDER=auto
EMBED_MODEL=text-embedding-3-small
# --- Vector store: memory | redis | qdrant ---
VECTOR_STORE=redis
# --- Cache policy ---
SIM_THRESHOLD=             # blank = 0.92 (openai) / 0.80 (local)
CACHE_TTL_S=3600
MAX_TEMPERATURE=1.0
CONTEXT_TURNS=0
ADMIN_TOKEN=
